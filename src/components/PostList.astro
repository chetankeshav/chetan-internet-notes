---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p>No posts yet.</p>}
<ul class="posts">
	{
		posts.map((post) => (
			<li>
				{post.data.thumbnail && (
					<a
						class="thumb-link"
						href={url(`/blog/${post.id}/`)}
						aria-label={post.data.title}
					>
						<Image
							class="thumbnail"
							width={240}
							height={160}
							src={post.data.thumbnail}
							alt=""
						/>
					</a>
				)}
				<div class="text">
					<a href={url(`/blog/${post.id}/`)}>
						<h3 class="title">
							{post.data.title}
							{post.data.draft && <span class="draft">draft</span>}
						</h3>
					</a>
					<p class="date">
						<FormattedDate date={post.data.pubDate} />
					</p>
					{post.data.description && <p class="description">{post.data.description}</p>}
					<TagList tags={post.data.tags} />
				</div>
			</li>
		))
	}
</ul>
<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		padding: 1.25em 0;
		border-bottom: 1px solid rgba(var(--gray-light), 100%);
	}
	.posts a {
		text-decoration: none;
	}
	.thumb-link {
		flex: 0 0 240px;
	}
	.thumbnail {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.text {
		flex: 1;
		min-width: 0;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.5em;
	}
	.posts a:hover .title {
		color: var(--accent);
	}
	.date,
	.description {
		margin: 0.25em 0 0;
		color: rgb(var(--gray));
	}
	.draft {
		margin-left: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: #fde68a;
		font-size: 0.5em;
		vertical-align: middle;
	}
	@media (max-width: 560px) {
		.posts li {
			flex-direction: column;
		}
		.thumb-link {
			flex: none;
			width: 100%;
			max-width: 320px;
		}
	}
</style>
