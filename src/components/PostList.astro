---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p>No posts yet.</p>}
<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={url(`/blog/${post.id}/`)}>
					{post.data.thumbnail && (
						<Image
							class="thumbnail"
							width={720}
							height={360}
							src={post.data.thumbnail}
							alt={post.data.title}
						/>
					)}
					<h3 class="title">
						{post.data.title}
						{post.data.draft && <span class="draft">draft</span>}
					</h3>
				</a>
				<p class="date">
					<FormattedDate date={post.data.pubDate} />
				</p>
				{post.data.description && <p class="description">{post.data.description}</p>}
				<TagList tags={post.data.tags} />
			</li>
		))
	}
</ul>
<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		padding: 1.25em 0;
		border-bottom: 1px solid rgba(var(--gray-light), 100%);
	}
	.posts a {
		text-decoration: none;
	}
	.thumbnail {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 0.75em;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.5em;
	}
	.posts a:hover .title {
		color: var(--accent);
	}
	.date,
	.description {
		margin: 0.25em 0 0;
		color: rgb(var(--gray));
	}
	.draft {
		margin-left: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: #fde68a;
		font-size: 0.5em;
		vertical-align: middle;
	}
</style>
