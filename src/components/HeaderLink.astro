---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../utils';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
// Compare on the first path segment after the base, e.g. "/tags/astro/" -> "tags"
const current = Astro.url.pathname.slice(url('/').length).split('/')[0];
const target = href.replace(/^\//, '').split('/')[0];
const isActive = current === target;
---

<a href={url(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
