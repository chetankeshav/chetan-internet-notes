---
import { url } from '../utils';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a href={url(`/tags/${tag}/`)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}
<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: inherit;
		gap: 0.5em;
		list-style: none;
		margin: 0.5em 0 0;
		padding: 0;
	}
	.tags a {
		display: inline-block;
		padding: 0.1em 0.6em;
		border-radius: 999px;
		background: rgba(var(--gray-light), 100%);
		color: rgb(var(--gray-dark));
		font-size: 0.85em;
		text-decoration: none;
	}
	.tags a:hover {
		color: var(--accent);
	}
</style>
