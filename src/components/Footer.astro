---
import { AUTHOR } from '../consts';
import { url } from '../utils';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {AUTHOR} · <a href={url('/rss.xml')}>RSS</a>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a {
		color: rgb(var(--gray));
	}
</style>
